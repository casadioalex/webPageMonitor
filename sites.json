{
  "defaults": {
    "viewports": [
      {
        "name": "desktop",
        "width": 1366,
        "height": 900
      },
      {
        "name": "mobile",
        "width": 390,
        "height": 844
      }
    ],
    "navTimeoutMs": 30000,
    "retries": 1,
    "visual": {
      "pixelmatchThreshold": 0.1,
      "maxDiffRatio": 0.01,
      "criticalDiffRatio": 0.08
    },
    "geometryTolerancePx": 4,
    "globalMaskSelectors": [
      ".cookie-banner",
      "#cookie-notice"
    ],
    "autoElements": true,
    "autoMaxElements": 150
  },
  "run": {
    "concurrency": 1,
    "maxRunMinutes": 120,
    "retentionDays": 30,
    "keepRuns": 3
  },
  "sites": [
    {
      "id": "stage-alex",
      "name": "Stage Alex (server interno)",
      "enabled": true,
      "pilot": true,
      "baseUrl": "http://192.168.0.252/test/stage_alex/",
      "pages": [
        {
          "name": "home",
          "path": ""
        },
        {
          "name": "how-it-works",
          "path": "how-it-works/"
        },
        {
          "name": "about-us",
          "path": "about-us/"
        },
        {
          "name": "FAQ",
          "path": "faq/"
        },
        {
          "name": "contact",
          "path": "contact/"
        }
      ]
    }
  ]
}